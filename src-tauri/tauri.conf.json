{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Blackboard",
  "version": "1.0.0",
  "identifier": "com.arkmith.blackboard",
    "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "title": "Blackboard",
        "label": "main",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "visible": false
      },
      {
        "title": "Loading...",
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 680,
        "height": 580,
        "decorations": false,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "© 2026 Ark Labs. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
